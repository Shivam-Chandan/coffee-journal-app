{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "coffee-journal-cloud",
  "version": "1.0.0",
  "description": "Read and create coffees in my personal Drupal coffee journal.",
  "author": {
    "name": "Shivam Chandan"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Coffee Journal Cloud",
        "shortDescription": "Your personal coffee journal",
        "defaultPrompt": "Help me manage my coffee journal."
      },
      "requires_local_executor": false
    }
  }
}
