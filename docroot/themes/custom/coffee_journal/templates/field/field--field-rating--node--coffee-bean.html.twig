{#
  Coffee Journal — Star Rating field template
  items[0].content['#markup'] contains the integer value (e.g. "5").
#}
{%- set rating_value = (items[0].content['#markup'] ?? '0') | trim | number_format(0) -%}
<div class="cj-stars" aria-label="Rating: {{ rating_value }} out of 5">
  {%- for i in 1..5 -%}
    {%- if i <= rating_value -%}
      <span class="star filled" aria-hidden="true">★</span>
    {%- else -%}
      <span class="star" aria-hidden="true">★</span>
    {%- endif -%}
  {%- endfor -%}
  <span class="cj-rating-badge">{{ rating_value }}/5</span>
</div>
