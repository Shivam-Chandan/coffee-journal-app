{#
  Coffee Journal — Roast Level field template
  items[0].content['#markup'] contains the display label (e.g. "Light").
#}
{%- set raw = (items[0].content['#markup'] ?? '') | trim -%}
{%- set value = raw | lower -%}
{%- if raw -%}
  <span class="roast-badge roast-badge--{{ value }}">{{ raw }}</span>
{%- endif -%}
