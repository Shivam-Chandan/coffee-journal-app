{#
  Coffee Journal — Roast Level field template
  field--field-roast-level--node--coffee-bean.html.twig
  Renders roast level as a colour-coded pill badge.
#}
{% for item in items %}
  {% set raw = item.content['#markup'] | default(item.content | render | striptags | trim) %}
  {% set value = raw | lower | trim %}
  <span class="roast-badge roast-badge--{{ value }}">{{ raw }}</span>
{% endfor %}
