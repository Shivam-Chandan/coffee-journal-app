{#
  Coffee bean add form — wireframe layout.

  Wireframe field primitives:
    .cj-field-wrap  — label (uppercase mono) above, bottom-border rule below
    .cj-form-section-head — section divider
    .cj-save-bar  — full-width accent save button at the bottom

  JS behaviors attached:
    cjFormScraper   — URL → field auto-fill
    cjRatingInputs  — upgrades range sliders + star picker
    cjSegmentedRoast — converts roast select into segmented control
#}

<form{{ attributes }}>

  {# ── URL SCRAPER ─────────────────────────────────────────────────────── #}
  {% if drupal_settings.coffeeJournal.scrapeEndpoint is defined %}
    <div class="cj-form-scraper">
      <div class="cj-scraper-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        {{ 'Import from URL'|t }}
      </div>
      <div class="cj-scraper-row">
        <input type="url" class="cj-scraper-input" id="cj-scraper-url"
               placeholder="{{ 'Paste product URL…'|t }}">
        <button type="button" class="cj-scraper-btn" id="cj-scraper-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M21 12a9 9 0 11-6.219-8.56"/>
          </svg>
          {{ 'Fetch'|t }}
        </button>
      </div>
    </div>
  {% endif %}

  {# ── BEAN INFO ────────────────────────────────────────────────────────── #}

  <div class="cj-field-wrap">{{ form.title }}</div>
  <div class="cj-field-wrap">{{ form.field_brand_roaster }}</div>
  <div class="cj-field-wrap">{{ form.field_estate }}</div>

  {# Roast level — segmented control #}
  <div class="cj-field-wrap">
    <span class="cj-field-label">{{ form.field_roast_level['#title'] }}</span>
    <div class="cj-segmented" data-cj-roast-control>
      {{ form.field_roast_level }}
    </div>
  </div>

  {# Form factor + quantity side-by-side #}
  <div class="cj-form-row">
    <div class="cj-field-wrap cj-field-wrap--half">{{ form.field_form_factor }}</div>
    <div class="cj-field-wrap cj-field-wrap--half">
      <span class="cj-field-label">{{ form.field_quantity['#title'] }}</span>
      <div class="cj-quantity-input-group">
        {{ form.field_quantity }}
        {{ form.field_quantity_unit }}
      </div>
    </div>
  </div>

  <div class="cj-field-wrap">{{ form.field_purchase_date }}</div>
  <div class="cj-field-wrap">{{ form.field_flavour_notes }}</div>

  {# ── TASTE PROFILE ────────────────────────────────────────────────────── #}
  <div class="cj-form-section-head">{{ 'Taste Profile'|t }}</div>

  <div class="cj-field-wrap">
    <span class="cj-field-label">{{ form.field_bitterness_rating['#title'] }}</span>
    {{ form.field_bitterness_rating }}
  </div>
  <div class="cj-field-wrap">
    <span class="cj-field-label">{{ form.field_acidity_rating['#title'] }}</span>
    {{ form.field_acidity_rating }}
  </div>
  <div class="cj-field-wrap">
    <span class="cj-field-label">{{ form.field_note_clarity_rating['#title'] }}</span>
    {{ form.field_note_clarity_rating }}
  </div>

  {# ── OVERALL RATING ───────────────────────────────────────────────────── #}
  <div class="cj-form-section-head">{{ 'Overall'|t }}</div>
  <div class="cj-field-wrap">{{ form.field_overall_taste_rating }}</div>

  {# ── NOTES / STATUS ───────────────────────────────────────────────────── #}
  {% if form.field_notes_review is defined %}
    <div class="cj-field-wrap">{{ form.field_notes_review }}</div>
  {% endif %}

  <div class="cj-form-checks">
    {% if form.field_is_finished is defined %}
      <div class="cj-field-wrap cj-field-wrap--check">{{ form.field_is_finished }}</div>
    {% endif %}
    {% if form.field_worth_reordering is defined %}
      <div class="cj-field-wrap cj-field-wrap--check">{{ form.field_worth_reordering }}</div>
    {% endif %}
  </div>

  {# ── SAVE BAR ─────────────────────────────────────────────────────────── #}
  {% if form.actions is defined %}
    <div class="cj-save-bar">
      {{ form.actions.submit }}
      {% if form.actions.delete is defined %}
        <button type="button" class="cj-save-bar__delete"
                onclick="this.closest('form').querySelector('[data-drupal-selector=\\'edit-delete\\']')?.click()">
          {{ 'Delete'|t }}
        </button>
      {% endif %}
    </div>
  {% endif %}

  {# Remaining system fields (CSRF token, build_id, etc.) #}
  {{ form|without(
    'title', 'field_brand_roaster', 'field_estate', 'field_roast_level',
    'field_form_factor', 'field_quantity', 'field_quantity_unit',
    'field_purchase_date', 'field_flavour_notes', 'field_bitterness_rating',
    'field_acidity_rating', 'field_note_clarity_rating', 'field_overall_taste_rating',
    'field_notes_review', 'field_is_finished', 'field_worth_reordering', 'actions'
  ) }}

</form>
