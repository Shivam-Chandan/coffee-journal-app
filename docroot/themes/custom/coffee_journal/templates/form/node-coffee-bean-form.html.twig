{#
  Coffee Journal — Coffee Bean node add/edit form override
  node-coffee-bean-form.html.twig

  Prepends the inline URL auto-fill widget (matching the source app's
  "Auto-fill details from URL" section at the top of CoffeeForm.tsx).

  The cjFormScraper JS behaviour (app.js) handles the fetch + field fill.
  drupalSettings.coffeeJournal.scrapeEndpoint is set by hook_preprocess_form.
#}
<div class="cj-form-scraper-inline" id="cj-inline-scraper">
  <div class="cj-scraper-inline__header">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2.5"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
    </svg>
    <span>{{ 'Auto-fill details from URL'|t }}</span>
  </div>
  <div class="cj-scraper-inline__row">
    <input type="url"
           id="cj-inline-scraper-url"
           class="cj-scraper-inline__input"
           placeholder="{{ 'Paste product page URL…'|t }}"
           autocomplete="off"
           aria-label="{{ 'Product page URL'|t }}">
    <button type="button"
            id="cj-inline-scraper-btn"
            class="cj-scraper-inline__btn">
      <span class="cj-inline-btn-label">{{ 'Auto-fill'|t }}</span>
      <span class="cj-inline-spinner" aria-hidden="true" hidden></span>
    </button>
  </div>
  <div id="cj-inline-scraper-status"
       class="cj-scraper-inline__status"
       role="status"
       aria-live="polite"></div>
</div>

{# Recipes inline area: server-rendered for existing coffee nodes, client-updated when new recipes are added #}
<div class="cj-form-recipes" id="cj-bean-recipes-wrap">
  <div class="cj-section__label">{{ 'Recipes'|t }}</div>
  <div id="cj-bean-recipes">
    {# If the server injected a form element with related recipes, render it here #}
    {% if form.cj_related_recipes is defined %}
      {{ form.cj_related_recipes }}
    {% endif %}
  </div>
  <div class="cj-form-recipes__actions">
    <button type="button" class="cj-btn cj-btn--secondary" data-cj-add-recipe>{{ 'Add Recipe'|t }}</button>
  </div>
</div>

{{ form }}
