<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    {#
      page_top and page_bottom are where Drupal injects the admin toolbar,
      contextual links, and other administrative overlays.
    #}
    {{ page_top }}

    <!-- COFFEE_JOURNAL_PAGE_TEMPLATE_LOADED -->
    <div id="cj-app">

      {# ── TOP BAR ─────────────────────────────────────────────────────── #}
      <header id="cj-topbar" role="banner">
        <a href="{{ path('<front>') }}" class="cj-brand" aria-label="{{ 'Coffee Journal'|t }} - {{ 'Home'|t }}">
          <span class="cj-brand-icon" aria-hidden="true">☕</span>
          <span>{{ 'Coffee Journal'|t }}</span>
        </a>

        {% if logged_in %}
          <div class="cj-topbar-actions">
            <a href="{{ logout_url }}"
               class="cj-topbar-logout"
               aria-label="{{ 'Sign out'|t }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span class="cj-topbar-logout__label">{{ 'Sign out'|t }}</span>
            </a>
          </div>
        {% endif %}
      </header>

      {# ── STATUS MESSAGES ─────────────────────────────────────────────── #}
      {% if page.status_messages %}
        <div id="cj-status-messages" role="alert" aria-live="polite">
          {{ page.status_messages }}
        </div>
      {% endif %}

      {# ── MAIN CONTENT ────────────────────────────────────────────────── #}
      <main id="cj-main" role="main">
        {# Skip to main content link for accessibility #}
        <a id="main-content" tabindex="-1"></a>
        <div class="cj-page-inner">
          {{ page.content }}
        </div>
      </main>

    </div>{# end #cj-app #}

    {# ── BOTTOM NAVIGATION ──────────────────────────────────────────────── #}
    <nav id="cj-bottom-nav" class="cj-bottom-nav" role="navigation" aria-label="{{ 'Main navigation'|t }}">

      <div class="cj-bottom-nav__group">
        <a href="{{ path('coffee_journal_api.global_feed') }}"
           class="cj-bottom-nav__item"
           data-cj-nav-feed>
          <span class="cj-nav-icon" aria-hidden="true">☕</span>
          <span class="cj-nav-label">{{ 'Feed'|t }}</span>
        </a>
        <a href="{{ path('view.coffee_journal.page_1') }}"
           class="cj-bottom-nav__item"
           data-cj-nav-my-coffees>
          <span class="cj-nav-icon" aria-hidden="true">📔</span>
          <span class="cj-nav-label">{{ 'Journal'|t }}</span>
        </a>
      </div>

      <div class="cj-bottom-nav__fab-slot">
        {% if logged_in %}
          <button class="cj-fab"
                  type="button"
                  aria-label="{{ 'Add coffee or brew'|t }}"
                  data-cj-add>
            <span aria-hidden="true">+</span>
          </button>
        {% endif %}
      </div>

      <div class="cj-bottom-nav__group">
        <a href="{{ logged_in ? path('coffee_journal_access.profile') : path('user.login') }}"
           class="cj-bottom-nav__item"
           data-cj-nav-profile>
          <span class="cj-nav-icon" aria-hidden="true">👤</span>
          <span class="cj-nav-label">{{ logged_in ? 'Profile'|t : 'Sign in'|t }}</span>
        </a>
        <a href="{{ logged_in ? path('coffee_journal_access.profile') ~ '?tab=saved' : path('user.login') }}"
           class="cj-bottom-nav__item"
           data-cj-nav-saved>
          <span class="cj-nav-icon" aria-hidden="true">⌑</span>
          <span class="cj-nav-label">{{ 'Saved'|t }}</span>
        </a>
      </div>

    </nav>

    {# ── Add / Edit Coffee Drawer — global, available on every page ────────── #}
    <div id="cj-drawer"
         class="cj-drawer"
         role="dialog"
         aria-modal="true"
         aria-labelledby="cj-drawer-title"
         aria-hidden="true"
         inert>

      <div class="cj-drawer__backdrop" id="cj-drawer-backdrop"></div>

      <div class="cj-drawer__sheet">

        <div class="cj-drawer__header">
          <h2 class="cj-drawer__title" id="cj-drawer-title">{{ 'Add Coffee'|t }}</h2>
          <button type="button"
                  class="cj-drawer__close"
                  id="cj-drawer-close"
                  aria-label="{{ 'Close'|t }}">
            {{ 'Close'|t }}
          </button>
        </div>

        <div id="cj-drawer-spinner" class="cj-drawer__spinner">
          <span class="cj-drawer__spinner-ring" aria-hidden="true"></span>
          <span class="visually-hidden">{{ 'Loading form…'|t }}</span>
        </div>

        <div id="cj-drawer-body" class="cj-drawer__body"></div>

      </div>
    </div>

    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
