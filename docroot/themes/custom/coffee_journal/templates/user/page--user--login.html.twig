{#
  Coffee Journal — Login page override
  page--user--login.html.twig

  Replaces the default Drupal username/password login form with a clean
  Google Sign-In screen. The Google OAuth flow is triggered by navigating
  to /user/login/google (registered by social_auth_google module).

  The standard Drupal login form is completely hidden for non-admin users.
  Admin (UID 1) can still access the full login form at /user/login?admin=1
  via the hidden link below.
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ 'Sign in — Coffee Journal'|t }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes.addClass('cj-login-page') }}>
    {{ page_top }}

    <div id="cj-app" class="cj-login-shell">

      {# ── Status messages (e.g. "you have been logged out") ── #}
      {% if page.status_messages %}
        <div id="cj-status-messages" role="alert" aria-live="polite">
          {{ page.status_messages }}
        </div>
      {% endif %}

      {# ── Login card ── #}
      <main id="cj-login" role="main" aria-label="{{ 'Sign in'|t }}">
        <div class="cj-login-card">

          {# ── Brand ── #}
          <div class="cj-login-brand" aria-hidden="true">☕</div>
          <h1 class="cj-login-title">{{ 'Coffee Journal'|t }}</h1>
          <p class="cj-login-tagline">
            {{ 'Track your brewing journey, one cup at a time.'|t }}
          </p>

          {# ── Google Sign-In button ── #}
          <a href="{{ path('social_auth.network.redirect', {'network': 'google'}) }}"
             class="cj-btn-google"
             aria-label="{{ 'Sign in with Google'|t }}">
            {# Google "G" logo SVG #}
            <svg class="cj-google-icon" xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            {{ 'Sign in with Google'|t }}
          </a>

          {# ── Hidden admin fallback ── #}
          <details class="cj-admin-login">
            <summary>{{ 'Admin access'|t }}</summary>
            {{ page.content }}
          </details>

        </div>
      </main>

    </div>

    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
