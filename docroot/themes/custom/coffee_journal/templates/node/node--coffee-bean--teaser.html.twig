{#
  Coffee bean teaser — wireframe tile: image stripe + name + roast + stars.
  Used in the 2-col journal grid.
#}
{% set overall_rating = node.field_overall_taste_rating.value|default(0)|round %}
{% set roast_val      = node.field_roast_level.value|default('') %}
{% set brand_val      = node.field_brand_roaster.value|default('') %}
{% set node_id        = node.id() %}

{% set roast_labels = {
  'light':        'Light',
  'light_medium': 'Light-Med',
  'medium':       'Medium',
  'medium_dark':  'Med-Dark',
  'dark':         'Dark'
} %}

<article{{ attributes.addClass('cj-card', 'cj-journal-tile') }}
        aria-label="{{ label }}">

  {# Image / placeholder #}
  <a href="{{ url }}" class="cj-journal-tile__img-link" tabindex="-1" aria-hidden="true">
    <div class="cj-journal-tile__image cj-image-stripe"></div>
  </a>

  {# Info row #}
  <div class="cj-journal-tile__info">
    <a href="{{ url }}" class="cj-journal-tile__name">{{ label }}</a>

    {% if brand_val %}
      <span class="cj-journal-tile__brand">{{ brand_val }}</span>
    {% endif %}

    {% if roast_val %}
      <span class="cj-journal-tile__roast">
        {{- roast_labels[roast_val]|default(roast_val|capitalize) -}}
      </span>
    {% endif %}

    <div class="cj-journal-tile__rating" aria-label="{{ 'Rating: %d/5'|format(overall_rating)|t }}">
      {%- for i in 1..5 -%}
        <span aria-hidden="true">{{ i <= overall_rating ? '★' : '☆' }}</span>
      {%- endfor -%}
    </div>
  </div>

  {# Owner-only edit action #}
  {% if user_can_edit %}
    <a href="{{ path('entity.node.edit_form', {'node': node_id}) }}"
       class="cj-journal-tile__edit"
       data-drawer-edit="true"
       aria-label="{{ 'Edit'|t }} {{ label }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
        <path d="m15 5 4 4"/>
      </svg>
    </a>
  {% endif %}

</article>
