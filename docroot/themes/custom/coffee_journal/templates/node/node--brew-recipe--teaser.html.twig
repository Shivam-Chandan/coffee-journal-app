{#
  Brew recipe teaser — used in the bean detail "Brews" list and in the feed card.

  Layout:
    - Method chip + ratio
    - Title link
    - Compact stat row (coffee·water·time)
    - Public/Private chip
    - Owner-only edit icon
#}
{% set node_id       = node.id() %}
{% set brew_method   = node.field_brew_method.value|default('') %}
{% set coffee_weight = node.field_coffee_weight.value|default(0)|number_format(0) %}
{% set water_weight  = node.field_water_weight.value|default(0)|number_format(0) %}
{% set brew_time     = node.field_brew_time is defined ? node.field_brew_time.value|default('') : '' %}
{% set is_public     = node.field_is_public.value %}

{% if coffee_weight and water_weight %}
  {% set ratio = (water_weight / coffee_weight)|round(1) %}
{% endif %}

<article{{ attributes.addClass('cj-card', 'cj-brew-card') }}>

  {# Method + ratio header #}
  <div class="cj-brew-card__head">
    {% if brew_method %}
      <span class="cj-chip cj-chip--filled">{{ brew_method }}</span>
    {% endif %}
    {% if ratio is defined %}
      <span class="cj-brew-card__ratio">1:{{ ratio }}</span>
    {% endif %}
    {% if is_public %}
      <span class="cj-chip" style="margin-left:auto">{{ 'Public'|t }}</span>
    {% endif %}
  </div>

  {# Title #}
  <a href="{{ url }}" class="cj-brew-card__title" data-drawer-view-recipe="true">{{ label }}</a>

  {# Compact stats row #}
  <div class="cj-brew-card__stats">
    {% if coffee_weight %}
      <span>{{ coffee_weight }}g</span>
    {% endif %}
    {% if water_weight %}
      <span>{{ water_weight }}g water</span>
    {% endif %}
    {% if brew_time %}
      <span>{{ brew_time }}</span>
    {% endif %}
  </div>

  {# Owner-only edit #}
  {% if user_can_edit %}
    <a href="{{ path('entity.node.edit_form', {'node': node_id}) }}"
       class="cj-brew-card__edit"
       data-drawer-recipe-edit="true"
       aria-label="{{ 'Edit'|t }} {{ label }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
        <path d="m15 5 4 4"/>
      </svg>
    </a>
  {% endif %}

</article>
