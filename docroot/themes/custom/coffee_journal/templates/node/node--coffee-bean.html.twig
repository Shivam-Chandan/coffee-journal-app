{#
  Coffee Journal — Coffee Bean full node page
  node--coffee-bean.html.twig
#}
{% set node_id    = node.id() %}
{% set edit_url   = '/node/' ~ node_id ~ '/edit' %}
{% set delete_url = '/node/' ~ node_id ~ '/delete' %}
{% set back_url   = '/my-coffee-journal' %}

{# Raw field values from entity for stars/badges #}
{% set rating_val  = node.field_rating.value | default(0) | number_format(0) %}
{% set roast_val   = node.field_roast_level.value | default('') | lower %}
{% set roast_label = node.field_roast_level.value | default('') %}
{% set roast_display = {
  'light':    'Light',
  'medium':   'Medium',
  'dark':     'Dark',
  'espresso': 'Espresso'
} %}

<article{{ attributes.addClass('node--type-coffee-bean', 'node--view-mode-full') }}>

  {# ── Back link ── #}
  <a class="cj-back-link" href="{{ back_url }}">My Coffee Journal</a>

  {# ── Node header ── #}
  <div class="cj-node-header">
    <h1>{{ label }}</h1>
    {% if rating_val > 0 %}
      <div class="cj-stars" aria-label="Rating: {{ rating_val }} out of 5">
        {%- for i in 1..5 -%}
          {%- if i <= rating_val -%}
            <span class="star filled" aria-hidden="true">★</span>
          {%- else -%}
            <span class="star" aria-hidden="true">★</span>
          {%- endif -%}
        {%- endfor -%}
        <span class="cj-rating-badge">{{ rating_val }}/5</span>
      </div>
    {% endif %}
  </div>

  {# ── Details section ── #}
  <div class="cj-section">
    <div class="cj-section__title">Details</div>

    {% if content.field_brand_roaster|render|striptags|trim is not empty %}
      <div class="cj-field-row">
        <span class="cj-field-label">Brand / Roaster</span>
        <span class="cj-field-value">{{ content.field_brand_roaster }}</span>
      </div>
    {% endif %}

    {% if roast_val %}
      <div class="cj-field-row">
        <span class="cj-field-label">Roast</span>
        <span class="cj-field-value">
          <span class="roast-badge roast-badge--{{ roast_val }}">
            {{- roast_display[roast_val] | default(roast_val | capitalize) -}}
          </span>
        </span>
      </div>
    {% endif %}

    {% if content.field_purchase_date|render|striptags|trim is not empty %}
      <div class="cj-field-row">
        <span class="cj-field-label">Purchase Date</span>
        <span class="cj-field-value">{{ content.field_purchase_date }}</span>
      </div>
    {% endif %}
  </div>

  {# ── Tasting Notes section ── #}
  {% if content.field_flavour_notes|render|striptags|trim is not empty
     or content.field_notes_review|render|striptags|trim is not empty %}
    <div class="cj-section">
      <div class="cj-section__title">Tasting Notes</div>

      {% if content.field_flavour_notes|render|striptags|trim is not empty %}
        <div class="cj-field-row">
          <span class="cj-field-label">Flavour Notes</span>
          <span class="cj-field-value cj-notes-text">{{ content.field_flavour_notes }}</span>
        </div>
      {% endif %}

      {% if content.field_notes_review|render|striptags|trim is not empty %}
        <div class="cj-field-row">
          <span class="cj-field-label">Review</span>
          <span class="cj-field-value cj-notes-text">{{ content.field_notes_review }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# ── Action links ── #}
  <ul class="links">
    <li>
      <a href="{{ edit_url }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
          <path d="m15 5 4 4"/>
        </svg>
        Edit
      </a>
    </li>
    <li>
      <a href="{{ delete_url }}" style="--cj-primary:hsl(0,65%,45%);--cj-primary-hover:hsl(0,65%,38%);">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6M14 11v6"/>
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
        </svg>
        Delete
      </a>
    </li>
  </ul>

</article>
