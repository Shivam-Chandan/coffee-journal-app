{#
  Coffee bean — full detail page (wireframe layout).
  Variables from preprocess: roast_label, roast_key, form_factor_label, brew_recipes,
  add_recipe_path, user_can_edit, user_can_delete, recipe_count, radar_polygon, radar_vals.
#}
{% set node_id        = node.id() %}
{% set edit_url       = path('entity.node.edit_form', {'node': node_id}) %}
{% set delete_url     = path('entity.node.delete_form', {'node': node_id}) %}
{% set brand_val      = node.field_brand_roaster.value|default('') %}
{% set estate_val     = node.field_estate.value|default('') %}
{% set date_val       = node.field_purchase_date.value|default('') %}
{% set tasting_notes  = node.field_flavour_notes.value|default('') %}
{% set is_finished    = node.field_is_finished.value %}
{% set worth_reorder  = node.field_worth_reordering.value %}

<article{{ attributes.addClass('cj-bean-detail') }}>

  {# ── Hero image stripe (full-width, no horizontal padding) ── #}
  <div class="cj-bean-detail__hero cj-image-stripe"></div>

  {# ── Caption: Roaster · Origin ── #}
  {% if brand_val or estate_val %}
    <div class="cj-bean-detail__meta">
      <span class="cj-bean-detail__origin">
        {{- [brand_val, estate_val]|filter(v => v is not empty)|join(' · ') -}}
      </span>
    </div>
  {% endif %}

  {# ── Title + edit actions ── #}
  <div class="cj-bean-detail__header">
    <h1 class="cj-bean-detail__title">{{ label }}</h1>
    {% if user_can_edit %}
      <div class="cj-bean-detail__actions">
        <a href="{{ edit_url }}" data-drawer-edit="true" aria-label="{{ 'Edit'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
            <path d="m15 5 4 4"/>
          </svg>
        </a>
        <a href="{{ delete_url }}" class="delete" aria-label="{{ 'Delete'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6M14 11v6"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>

  {# ── Roast · Date meta chips ── #}
  <div class="cj-bean-detail__chips">
    {% if roast_label %}
      <span class="cj-chip cj-chip--filled">{{ roast_label }}</span>
    {% endif %}
    {% if date_val %}
      <span class="cj-chip">{{ date_val|date('d M Y') }}</span>
    {% endif %}
    {% if is_finished %}
      <span class="cj-chip">{{ 'Finished'|t }}</span>
    {% endif %}
    {% if worth_reorder %}
      <span class="cj-chip">{{ 'Would Reorder'|t }}</span>
    {% endif %}
  </div>

  {# ── Rating radar ── #}
  {% if radar_polygon %}
    <div class="cj-rating-radar cj-bean-detail__radar">
      <svg width="80" height="80" viewBox="0 0 56 56"
           aria-label="{{ 'Rating chart'|t }}"
           role="img">
        {# Grid rings #}
        {% for i in [1, 2, 3, 4, 5] %}
          <circle cx="28" cy="28" r="{{ (i / 5 * 24)|round(1) }}"
                  fill="none" stroke="var(--cj-hair)" stroke-width="0.5"/>
        {% endfor %}
        {# Axes: top, right, bottom, left #}
        <line x1="28" y1="28" x2="28" y2="4"  stroke="var(--cj-hair)" stroke-width="0.5"/>
        <line x1="28" y1="28" x2="52" y2="28" stroke="var(--cj-hair)" stroke-width="0.5"/>
        <line x1="28" y1="28" x2="28" y2="52" stroke="var(--cj-hair)" stroke-width="0.5"/>
        <line x1="28" y1="28" x2="4"  y2="28" stroke="var(--cj-hair)" stroke-width="0.5"/>
        {# Data polygon #}
        <polygon points="{{ radar_polygon }}"
                 fill="var(--cj-accent-soft)"
                 stroke="var(--cj-primary)"
                 stroke-width="1.2"
                 stroke-linejoin="round"/>
        {# Labels #}
        <text x="28" y="3"  text-anchor="middle" font-size="4" fill="var(--cj-ink-2)">{{ 'Body'|t }}</text>
        <text x="55" y="29" text-anchor="start"  font-size="4" fill="var(--cj-ink-2)">{{ 'Acidity'|t }}</text>
        <text x="28" y="56" text-anchor="middle" font-size="4" fill="var(--cj-ink-2)">{{ 'Aroma'|t }}</text>
        <text x="1"  y="29" text-anchor="start"  font-size="4" fill="var(--cj-ink-2)">{{ 'Sweet'|t }}</text>
      </svg>
      <div class="cj-rating-radar__labels">
        {% if radar_vals %}
          <span>{{ 'Body'|t }} {{ (radar_vals.body * 2)|round }}/10</span>
          <span>{{ 'Acidity'|t }} {{ (radar_vals.acidity * 2)|round }}/10</span>
          <span>{{ 'Aroma'|t }} {{ (radar_vals.aroma * 2)|round }}/10</span>
          <span>{{ 'Sweet'|t }} {{ radar_vals.sweetness|round }}/5</span>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {# ── Tasting Notes ── #}
  {% if tasting_notes %}
    <div class="cj-bean-detail__notes">
      <div class="cj-wf-section-head">{{ 'Tasting Notes'|t }}</div>
      <p class="cj-bean-detail__notes-text">{{ tasting_notes }}</p>
    </div>
  {% endif %}

  {# ── Brew Recipes ── #}
  <div class="cj-bean-detail__brews">
    <div class="cj-wf-section-head">
      {{ 'Brews'|t }}
      {% if recipe_count is defined and recipe_count > 0 %}
        <span class="cj-chip">{{ recipe_count }}</span>
      {% endif %}
    </div>

    {% if brew_recipes is defined and brew_recipes|length > 0 %}
      <div class="cj-recipes-list">
        {% for recipe in brew_recipes %}
          {{ recipe }}
        {% endfor %}
      </div>
    {% else %}
      <div class="cj-wf-empty cj-wf-empty--inline">
        <p class="cj-wf-empty__sub">{{ 'No brews yet.'|t }}</p>
      </div>
    {% endif %}

    {% if user_can_edit %}
      <a href="{{ add_recipe_path }}"
         class="cj-btn-add-brew"
         data-cj-add-recipe
         data-bean-nid="{{ node_id }}">
        {{ '+ Add brew'|t }}
      </a>
    {% endif %}
  </div>

</article>
