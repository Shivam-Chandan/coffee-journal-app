{#
  Coffee bean — full detail page (wireframe layout).
  Variables from preprocess: roast_label, roast_key, form_factor_label, brew_recipes,
  add_recipe_path, user_can_edit, user_can_delete, recipe_count, radar_polygon, radar_vals.
#}
{% set node_id        = node.id() %}
{% set edit_url       = path('entity.node.edit_form', {'node': node_id}) %}
{% set delete_url     = path('entity.node.delete_form', {'node': node_id}) %}
{% set brand_val      = node.field_brand_roaster.value|default('') %}
{% set estate_val     = node.field_estate.value|default('') %}
{% set date_val       = node.field_purchase_date.value|default('') %}
{% set tasting_notes  = node.field_flavour_notes.value|default('') %}
{% set is_finished    = node.field_is_finished.value %}
{% set worth_reorder  = node.field_worth_reordering.value %}

<article{{ attributes.addClass('cj-bean-detail') }}>

  {# ── Hero image stripe (full-width, no horizontal padding) ── #}
  <div class="cj-bean-detail__hero cj-image-stripe"></div>

  {# ── Caption: Roaster · Origin ── #}
  {% if brand_val or estate_val %}
    <div class="cj-bean-detail__meta">
      <span class="cj-bean-detail__origin">
        {{- [brand_val, estate_val]|filter(v => v is not empty)|join(' · ') -}}
      </span>
    </div>
  {% endif %}

  {# ── Title + edit actions ── #}
  <div class="cj-bean-detail__header">
    <h1 class="cj-bean-detail__title">{{ label }}</h1>
    {% if user_can_edit %}
      <div class="cj-bean-detail__actions">
        <a href="{{ edit_url }}" data-drawer-edit="true" aria-label="{{ 'Edit'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
            <path d="m15 5 4 4"/>
          </svg>
        </a>
        <a href="{{ delete_url }}" class="delete" aria-label="{{ 'Delete'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6M14 11v6"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>

  {# ── Roast · Date meta chips ── #}
  <div class="cj-bean-detail__chips">
    {% if roast_label %}
      <span class="cj-chip cj-chip--filled">{{ roast_label }}</span>
    {% endif %}
    {% if date_val %}
      <span class="cj-chip">{{ date_val|date('d M Y') }}</span>
    {% endif %}
    {% if is_finished %}
      <span class="cj-chip">{{ 'Finished'|t }}</span>
    {% endif %}
    {% if worth_reorder %}
      <span class="cj-chip">{{ 'Would Reorder'|t }}</span>
    {% endif %}
  </div>

  {# ── Rating radar ── #}
  {#
    Grid: viewBox 0 0 100 100, centre (50,50), max-radius 34.
    Axes (clockwise from top): Overall Taste=(50,16) · Bitterness=(84,50) · Acidity=(50,84) · Note Clarity=(16,50)
    Labels sit just beyond each tip. SVG has overflow:visible so text doesn't clip.
  #}
  {% if radar_polygon %}
    <div class="cj-bean-detail__radar-wrap">
      <div class="cj-wf-section-head">{{ 'Taste Profile'|t }}</div>
      <div class="cj-rating-radar">

        <svg class="cj-rating-radar__svg"
             viewBox="0 0 100 100"
             overflow="visible"
             aria-label="{{ 'Taste profile radar'|t }}"
             role="img">

          {# ── Background grid rings (5 steps) ── #}
          {% for i in [1, 2, 3, 4, 5] %}
            <circle cx="50" cy="50" r="{{ (i / 5 * 34)|round(1) }}"
                    fill="{% if i == 5 %}var(--cj-hair){% else %}none{% endif %}"
                    fill-opacity="0.25"
                    stroke="var(--cj-hair)"
                    stroke-width="0.6"/>
          {% endfor %}

          {# ── Axis spokes ── #}
          <line x1="50" y1="50" x2="50" y2="16" stroke="var(--cj-hair)" stroke-width="0.6"/>
          <line x1="50" y1="50" x2="84" y2="50" stroke="var(--cj-hair)" stroke-width="0.6"/>
          <line x1="50" y1="50" x2="50" y2="84" stroke="var(--cj-hair)" stroke-width="0.6"/>
          <line x1="50" y1="50" x2="16" y2="50" stroke="var(--cj-hair)" stroke-width="0.6"/>

          {# ── Data polygon ── #}
          <polygon points="{{ radar_polygon }}"
                   fill="var(--cj-accent-soft)"
                   stroke="var(--cj-primary)"
                   stroke-width="1.5"
                   stroke-linejoin="round"/>

          {# ── Vertex dots ── #}
          {% set pts = radar_polygon|split(' ') %}
          {% for pt in pts %}
            {% set xy = pt|split(',') %}
            <circle cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="2"
                    fill="var(--cj-primary)"/>
          {% endfor %}

          {# ── Axis labels — actual field names ── #}
          <text x="50"  y="10"  text-anchor="middle" dominant-baseline="middle"
                font-size="5.5" fill="var(--cj-ink-2)" font-weight="600">{{ 'Overall'|t }}</text>
          <text x="90"  y="50"  text-anchor="start"  dominant-baseline="middle"
                font-size="5.5" fill="var(--cj-ink-2)" font-weight="600">{{ 'Bitter'|t }}</text>
          <text x="50"  y="92"  text-anchor="middle" dominant-baseline="middle"
                font-size="5.5" fill="var(--cj-ink-2)" font-weight="600">{{ 'Acidity'|t }}</text>
          <text x="10"  y="50"  text-anchor="end"    dominant-baseline="middle"
                font-size="5.5" fill="var(--cj-ink-2)" font-weight="600">{{ 'Clarity'|t }}</text>

        </svg>

        {# ── Score row — actual field values with correct denominators ── #}
        {% if radar_vals %}
          <div class="cj-rating-radar__scores">
            <div class="cj-rating-radar__score-item">
              <span class="cj-rating-radar__score-name">{{ 'Overall'|t }}</span>
              <span class="cj-rating-radar__score-val">{{ radar_vals.overall_taste|round }}<span class="cj-rating-radar__score-max">/5</span></span>
            </div>
            <div class="cj-rating-radar__score-item">
              <span class="cj-rating-radar__score-name">{{ 'Bitter'|t }}</span>
              <span class="cj-rating-radar__score-val">{{ radar_vals.bitterness|round }}<span class="cj-rating-radar__score-max">/10</span></span>
            </div>
            <div class="cj-rating-radar__score-item">
              <span class="cj-rating-radar__score-name">{{ 'Acidity'|t }}</span>
              <span class="cj-rating-radar__score-val">{{ radar_vals.acidity|round }}<span class="cj-rating-radar__score-max">/10</span></span>
            </div>
            <div class="cj-rating-radar__score-item">
              <span class="cj-rating-radar__score-name">{{ 'Clarity'|t }}</span>
              <span class="cj-rating-radar__score-val">{{ radar_vals.note_clarity|round }}<span class="cj-rating-radar__score-max">/10</span></span>
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  {% endif %}

  {# ── Tasting Notes ── #}
  {% if tasting_notes %}
    <div class="cj-bean-detail__notes">
      <div class="cj-wf-section-head">{{ 'Tasting Notes'|t }}</div>
      <p class="cj-bean-detail__notes-text">{{ tasting_notes }}</p>
    </div>
  {% endif %}

  {# ── Brew Recipes ── #}
  <div class="cj-bean-detail__brews">
    <div class="cj-wf-section-head">
      {{ 'Brews'|t }}
      {% if recipe_count is defined and recipe_count > 0 %}
        <span class="cj-chip">{{ recipe_count }}</span>
      {% endif %}
    </div>

    {% if brew_recipes is defined and brew_recipes|length > 0 %}
      <div class="cj-recipes-list">
        {% for recipe in brew_recipes %}
          {{ recipe }}
        {% endfor %}
      </div>
    {% else %}
      <div class="cj-wf-empty cj-wf-empty--inline">
        <p class="cj-wf-empty__sub">{{ 'No brews yet.'|t }}</p>
      </div>
    {% endif %}

    {% if user_can_edit %}
      <a href="{{ add_recipe_path }}"
         class="cj-btn-add-brew"
         data-cj-add-recipe
         data-bean-nid="{{ node_id }}">
        {{ '+ Add brew'|t }}
      </a>
    {% endif %}
  </div>

</article>
