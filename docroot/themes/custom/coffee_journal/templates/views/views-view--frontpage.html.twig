{#
  Coffee Journal — Frontpage view wrapper
  views-view--frontpage.html.twig
#}
{% if not view.is_attachment() %}
  <div{{ attributes.addClass('view', 'view-frontpage') }}>

    {% if header %}
      <div class="cj-view-header">{{ header }}</div>
    {% endif %}

    {% if exposed %}
      <div class="view-filters">{{ exposed }}</div>
    {% endif %}

    {% if attachment_before %}
      <div class="attachment attachment-before">{{ attachment_before }}</div>
    {% endif %}

    {% if rows %}
      <div class="cj-grid view-content">{{ rows }}</div>
    {% elseif empty %}
      <div class="cj-empty view-empty">{{ empty }}</div>
    {% endif %}

    {% if pager %}
      <div class="view-pager">{{ pager }}</div>
    {% endif %}

    {% if attachment_after %}
      <div class="attachment attachment-after">{{ attachment_after }}</div>
    {% endif %}

    {% if more %}
      <div class="view-more">{{ more }}</div>
    {% endif %}

  </div>
{% else %}
  {{ rows }}
{% endif %}
