{#
  Coffee Journal — My Coffee Journal view wrapper
  views-view--coffee-journal.html.twig

  Renders the journal grid plus:
    - Controls row: count label + sort using the Drupal Views exposed form
    - FAB button (opens add-coffee drawer)
    - "Import from URL" button (opens add-coffee drawer, scraper auto-focused)
    - #cj-drawer: the slide-up sheet that loads the add/edit form via fetch

  The cjAddDrawer JS behaviour handles all drawer open/close/submit logic.
  The cjSort JS behaviour auto-submits the Views exposed form on select change,
  hiding the submit button and sort-order select (always kept DESC).
#}
{% if not view.is_attachment() %}
  <div{{ attributes.addClass('view', 'view-coffee-journal') }}>

    {# ── Page heading ── #}
    <div class="cj-view-heading">
      <h1>{{ 'My Coffee Journal'|t }}</h1>
      {# "Import from URL" — opens drawer with inline scraper auto-focused #}
      <button type="button"
              id="cj-import-url-btn"
              class="cj-btn-scraper"
              aria-label="{{ 'Import coffee details from a product URL'|t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        {{ 'Import from URL'|t }}
      </button>
    </div>

    {# ── Controls row: count label + Drupal Views exposed sort form ── #}
    {#
      The exposed form is rendered here as-is. cjSort JS:
        1. Hides the sort_order select (locked to DESC) and the submit button
        2. Adds a "Sort by" label before the sort_by select
        3. Auto-submits the form when sort_by changes
      This means actual sorting goes through Drupal Views correctly.
    #}
    <div class="cj-controls-row">
      <span class="cj-count" id="cj-coffee-count"></span>
      {% if exposed %}
        <div class="cj-sort-wrap" id="cj-sort-wrap">{{ exposed }}</div>
      {% endif %}
    </div>

    {% if header %}
      <div class="cj-view-header">{{ header }}</div>
    {% endif %}

    {% if attachment_before %}
      <div class="attachment attachment-before">{{ attachment_before }}</div>
    {% endif %}

    {% if rows %}
      <div class="cj-grid view-content" id="cj-grid">{{ rows }}</div>
    {% elseif empty %}
      <div class="cj-empty view-empty">
        <span class="cj-empty-icon" aria-hidden="true">☕</span>
        <p>{{ 'Your coffee journal is empty.'|t }}</p>
        <a href="{{ path('node.add', {'node_type': 'coffee_bean'}) }}" class="button">
          {{ 'Add your first coffee'|t }}
        </a>
      </div>
    {% endif %}

    {% if pager %}
      <div class="view-pager">{{ pager }}</div>
    {% endif %}

    {% if attachment_after %}
      <div class="attachment attachment-after">{{ attachment_after }}</div>
    {% endif %}

    {% if more %}
      <div class="view-more">{{ more }}</div>
    {% endif %}

  </div>

  {# ── FAB — button (not link) — opens the add-coffee drawer ── #}
  <button type="button"
          class="cj-fab"
          aria-label="{{ 'Add a Coffee Bean'|t }}"
          title="{{ 'Add a Coffee Bean'|t }}">
    <span aria-hidden="true">+</span>
  </button>

{% else %}
  {{ rows }}
{% endif %}
