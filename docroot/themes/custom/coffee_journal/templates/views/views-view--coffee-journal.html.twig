{#
  Coffee Journal — My Coffee Journal view wrapper
  views-view--coffee-journal.html.twig

  Renders the journal grid plus:
    - Sort dropdown (Order Date / Rating)
    - FAB button (opens add-coffee drawer)
    - "Import from URL" button (opens add-coffee drawer, scraper auto-focused)
    - #cj-drawer: the slide-up sheet that loads the add/edit form via fetch

  The cjAddDrawer JS behaviour handles all drawer open/close/submit logic.
  The cjSort JS behaviour handles the sort dropdown.
#}
{% if not view.is_attachment() %}
  <div{{ attributes.addClass('view', 'view-coffee-journal') }}>

    {# ── Page heading ── #}
    <div class="cj-view-heading">
      <h1>{{ 'My Coffee Journal'|t }}</h1>
      {# "Import from URL" — opens drawer with inline scraper auto-focused #}
      <button type="button"
              id="cj-import-url-btn"
              class="cj-btn-scraper"
              aria-label="{{ 'Import coffee details from a product URL'|t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        {{ 'Import from URL'|t }}
      </button>
    </div>

    {# ── Controls row: count + sort dropdown ── #}
    <div class="cj-controls-row">
      <span class="cj-count" id="cj-coffee-count"></span>
      <div class="cj-sort-wrap">
        <label for="cj-sort-select" class="cj-sort-label">{{ 'Sort by'|t }}</label>
        <select id="cj-sort-select" class="cj-sort-select" aria-label="{{ 'Sort coffees by'|t }}">
          <option value="orderDate">{{ 'Order Date'|t }}</option>
          <option value="overallTasteRating">{{ 'Rating'|t }}</option>
        </select>
      </div>
    </div>

    {% if header %}
      <div class="cj-view-header">{{ header }}</div>
    {% endif %}

    {# Drupal exposed form hidden — sort is driven by cjSort JS via URL params #}
    {% if exposed %}
      <div class="view-filters visually-hidden" aria-hidden="true">{{ exposed }}</div>
    {% endif %}

    {% if attachment_before %}
      <div class="attachment attachment-before">{{ attachment_before }}</div>
    {% endif %}

    {% if rows %}
      <div class="cj-grid view-content" id="cj-grid">{{ rows }}</div>
    {% elseif empty %}
      <div class="cj-empty view-empty">
        <span class="cj-empty-icon" aria-hidden="true">☕</span>
        <p>{{ 'Your coffee journal is empty.'|t }}</p>
        <a href="{{ path('node.add', {'node_type': 'coffee_bean'}) }}" class="button">
          {{ 'Add your first coffee'|t }}
        </a>
      </div>
    {% endif %}

    {% if pager %}
      <div class="view-pager">{{ pager }}</div>
    {% endif %}

    {% if attachment_after %}
      <div class="attachment attachment-after">{{ attachment_after }}</div>
    {% endif %}

    {% if more %}
      <div class="view-more">{{ more }}</div>
    {% endif %}

  </div>

  {# ── FAB — button (not link) — opens the add-coffee drawer ── #}
  <button type="button"
          class="cj-fab"
          aria-label="{{ 'Add a Coffee Bean'|t }}"
          title="{{ 'Add a Coffee Bean'|t }}">
    <span aria-hidden="true">+</span>
  </button>

  {# ── Add / Edit Coffee Drawer ─────────────────────────────────────────── #}
  {#
    Slide-up sheet matching source app's IonModal.
    The drawer body is populated by cjAddDrawer JS via fetch — no form markup here.
    The close button matches the source app's IonButton in the IonToolbar header.
  #}
  <div id="cj-drawer"
       class="cj-drawer"
       role="dialog"
       aria-modal="true"
       aria-labelledby="cj-drawer-title"
       aria-hidden="true"
       inert>

    <div class="cj-drawer__backdrop" id="cj-drawer-backdrop"></div>

    <div class="cj-drawer__sheet">

      {# ── Drawer header — matches IonHeader + IonToolbar + IonTitle ── #}
      <div class="cj-drawer__header">
        <h2 class="cj-drawer__title" id="cj-drawer-title">{{ 'Add Coffee'|t }}</h2>
        <button type="button"
                class="cj-drawer__close"
                id="cj-drawer-close"
                aria-label="{{ 'Close'|t }}">
          {{ 'Close'|t }}
        </button>
      </div>

      {# ── Loading spinner (shown while form HTML is being fetched) ── #}
      <div id="cj-drawer-spinner" class="cj-drawer__spinner">
        <span class="cj-drawer__spinner-ring" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'Loading form…'|t }}</span>
      </div>

      {# ── Drawer body — form HTML injected here by JS ── #}
      <div id="cj-drawer-body" class="cj-drawer__body"></div>

    </div>
  </div>

{% else %}
  {{ rows }}
{% endif %}
