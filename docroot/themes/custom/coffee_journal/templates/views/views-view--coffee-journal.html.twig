{#
  Coffee Journal — My Coffee Journal view wrapper
  views-view--coffee-journal.html.twig

  Renders the journal grid plus two action entry-points:
    1. FAB (+) — quick link to /node/add/coffee_bean
    2. "Scrape from URL" button — opens the Gemini scraper modal overlay
       (modal markup lives here; JS in app.js drives its behaviour)
#}
{% if not view.is_attachment() %}
  <div{{ attributes.addClass('view', 'view-coffee-journal') }}>

    {# ── Page heading ── #}
    <div class="cj-view-heading">
      <h1>{{ 'My Coffee Journal'|t }}</h1>
      {# Scraper trigger — desktop-visible shortcut next to the heading #}
      <button type="button"
              id="cj-scraper-trigger"
              class="cj-btn-scraper"
              aria-haspopup="dialog"
              aria-controls="cj-scraper-modal">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        {{ 'Import from URL'|t }}
      </button>
    </div>

    {% if header %}
      <div class="cj-view-header">{{ header }}</div>
    {% endif %}

    {% if exposed %}
      <div class="view-filters">{{ exposed }}</div>
    {% endif %}

    {% if attachment_before %}
      <div class="attachment attachment-before">{{ attachment_before }}</div>
    {% endif %}

    {% if rows %}
      <div class="cj-grid view-content">{{ rows }}</div>
    {% elseif empty %}
      <div class="cj-empty view-empty">
        <span class="cj-empty-icon" aria-hidden="true">☕</span>
        <p>{{ 'Your coffee journal is empty.'|t }}</p>
        <a href="{{ path('node.add', {'node_type': 'coffee_bean'}) }}" class="button">
          {{ 'Add your first coffee'|t }}
        </a>
      </div>
    {% endif %}

    {% if pager %}
      <div class="view-pager">{{ pager }}</div>
    {% endif %}

    {% if attachment_after %}
      <div class="attachment attachment-after">{{ attachment_after }}</div>
    {% endif %}

    {% if more %}
      <div class="view-more">{{ more }}</div>
    {% endif %}

  </div>

  {# ── FAB — always rendered server-side for all authenticated users ── #}
  <a href="{{ path('node.add', {'node_type': 'coffee_bean'}) }}"
     class="cj-fab"
     aria-label="{{ 'Add a Coffee Bean'|t }}"
     title="{{ 'Add a Coffee Bean'|t }}">
    <span aria-hidden="true">+</span>
  </a>

  {# ── Gemini Scraper Modal ──────────────────────────────────────────────── #}
  {#
    Triggered by #cj-scraper-trigger and the FAB long-press (JS).
    Hidden by default; JS toggles aria-hidden + inert.
    On submit: POSTs to /api/scrape-coffee, then redirects to
    /node/add/coffee_bean pre-filled via query params (handled by JS).
  #}
  <div id="cj-scraper-modal"
       class="cj-modal"
       role="dialog"
       aria-modal="true"
       aria-labelledby="cj-scraper-modal-title"
       aria-hidden="true"
       inert>

    <div class="cj-modal__backdrop" id="cj-scraper-backdrop"></div>

    <div class="cj-modal__panel">

      <div class="cj-modal__header">
        <h2 id="cj-scraper-modal-title">{{ 'Import Coffee from URL'|t }}</h2>
        <button type="button" class="cj-modal__close" aria-label="{{ 'Close'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <p class="cj-modal__hint">
        {{ 'Paste a product page URL (e.g. a roaster\'s shop page) and AI will extract the coffee details automatically.'|t }}
      </p>

      <div class="cj-modal__body">
        <label for="cj-scraper-url" class="cj-modal__label">
          {{ 'Product URL'|t }}
        </label>
        <div class="cj-modal__input-row">
          <input type="url"
                 id="cj-scraper-url"
                 class="cj-modal__input"
                 placeholder="https://roaster.com/products/..."
                 autocomplete="off"
                 aria-describedby="cj-scraper-status">
          <button type="button" id="cj-scraper-submit" class="cj-modal__fetch-btn">
            <span class="cj-scraper-btn-label">{{ 'Extract'|t }}</span>
            <span class="cj-scraper-spinner" aria-hidden="true" hidden></span>
          </button>
        </div>
        <div id="cj-scraper-status"
             class="cj-modal__status"
             role="status"
             aria-live="polite"></div>
      </div>

      {# Preview panel — shown after successful extraction #}
      <div id="cj-scraper-preview" class="cj-modal__preview" hidden>
        <div class="cj-modal__preview-title" id="cj-preview-name"></div>
        <dl class="cj-modal__preview-meta">
          <div class="cj-preview-row" id="cj-preview-brand-row">
            <dt>{{ 'Brand'|t }}</dt><dd id="cj-preview-brand"></dd>
          </div>
          <div class="cj-preview-row" id="cj-preview-roast-row">
            <dt>{{ 'Roast'|t }}</dt><dd id="cj-preview-roast"></dd>
          </div>
          <div class="cj-preview-row" id="cj-preview-notes-row">
            <dt>{{ 'Notes'|t }}</dt><dd id="cj-preview-notes"></dd>
          </div>
          <div class="cj-preview-row" id="cj-preview-quantity-row">
            <dt>{{ 'Quantity'|t }}</dt><dd id="cj-preview-quantity"></dd>
          </div>
        </dl>
        <button type="button" id="cj-scraper-use" class="cj-modal__use-btn">
          {{ 'Use these details'|t }}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

{% else %}
  {{ rows }}
{% endif %}

