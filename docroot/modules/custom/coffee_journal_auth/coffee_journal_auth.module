<?php

/**
 * @file
 * Form integration for Coffee Journal's native authentication transition.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element\Email;
use Drupal\Core\Url;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function coffee_journal_auth_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Preserve native validation ordering, flood control, and submission.
  $form['name']['#title'] = t('Email address or username');
  $form['name']['#maxlength'] = max(UserInterface::USERNAME_MAX_LENGTH, Email::EMAIL_MAX_LENGTH);
  $form['name']['#description'] = t('Use your registered email address. Existing non-email usernames also work.');

  $form['account_help'] = [
    '#type' => 'container',
    '#weight' => 100,
    'recovery' => [
      '#type' => 'link',
      '#title' => t('Forgot password / Set up password'),
      '#url' => Url::fromRoute('user.pass'),
    ],
    'register' => [
      '#type' => 'container',
      '#access' => \Drupal::config('user.settings')->get('register') !== UserInterface::REGISTER_ADMINISTRATORS_ONLY,
      'link' => [
        '#type' => 'link',
        '#title' => t('Create an account'),
        '#url' => Url::fromRoute('user.register'),
      ],
    ],
  ];
  $form['#cache']['tags'][] = 'config:user.settings';
}
