<?php

declare(strict_types=1);

use Drupal\Core\Session\AccountInterface;
use Drupal\file\Entity\File;
use Drupal\user\UserInterface;

/**
 * Implements hook_node_presave().
 */
function coffee_journal_api_node_presave(\Drupal\node\NodeInterface $node): void {
  \Drupal::service('coffee_journal_api.provenance')->presave($node);
  if ($node->bundle() === 'coffee_order') {
    \Drupal::service('coffee_journal_api.orders')->presave($node);
  }
}

/** Implements hook_node_insert(). */
function coffee_journal_api_node_insert(\Drupal\node\NodeInterface $node): void {
  _coffee_journal_api_order_saved($node, TRUE);
}

/** Implements hook_node_update(). */
function coffee_journal_api_node_update(\Drupal\node\NodeInterface $node): void {
  _coffee_journal_api_order_saved($node, FALSE);
}

/** Implements hook_node_delete(). */
function coffee_journal_api_node_delete(\Drupal\node\NodeInterface $node): void {
  if ($node->bundle() === 'coffee_bean') {
    foreach (\Drupal::service('coffee_journal_api.orders')->history($node) as $order) {
      $order->delete();
    }
  }
}

/** Routes lifecycle events through the shared order service. */
function _coffee_journal_api_order_saved(\Drupal\node\NodeInterface $node, bool $new): void {
  $orders = \Drupal::service('coffee_journal_api.orders');
  if ($node->bundle() === 'coffee_bean') {
    $orders->beanSaved($node, $new);
  }
  elseif ($node->bundle() === 'coffee_order') {
    $orders->project($node);
  }
}

/**
 * Implements hook_entity_field_access().
 */
function coffee_journal_api_entity_field_access($operation, $field_definition, $account, $items = NULL) {
  if ($field_definition->getTargetEntityTypeId() === 'node'
    && in_array($field_definition->getName(), \Drupal\coffee_journal_api\Service\CreationProvenance::FIELDS, TRUE)) {
    return \Drupal\Core\Access\AccessResult::forbidden();
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_cron().
 */
function coffee_journal_api_cron(): void {
  \Drupal::database()->delete('coffee_journal_create_receipt')
    ->condition('expires', \Drupal::time()->getCurrentTime(), '<=')->execute();
}

/**
 * Implements hook_user_login().
 *
 * Maps available Google profile data from the social auth session to the
 * Drupal user account on first login.
 */
function coffee_journal_api_user_login(AccountInterface $account): void {
  if (!$account instanceof UserInterface || $account->isAnonymous()) {
    return;
  }

  $profile = _coffee_journal_api_get_social_auth_profile();
  if (empty($profile) || !is_array($profile)) {
    return;
  }

  $updated = FALSE;

  if ($account->get('field_profile_picture')->isEmpty() && !empty($profile['picture']) && filter_var($profile['picture'], FILTER_VALIDATE_URL)) {
    $file = _coffee_journal_api_save_remote_profile_image((string) $profile['picture']);
    if ($file) {
      $account->set('field_profile_picture', [
        'target_id' => $file->id(),
        'alt' => $account->getDisplayName() . ' profile picture',
      ]);
      $updated = TRUE;
    }
  }

  if ($account->get('field_bio')->isEmpty() && !empty($profile['bio'])) {
    $account->set('field_bio', [
      'value' => (string) $profile['bio'],
      'format' => 'plain_text',
    ]);
    $updated = TRUE;
  }

  if ($account->get('field_experience_level')->isEmpty() && !empty($profile['experienceLevel'])) {
    $account->set('field_experience_level', (string) $profile['experienceLevel']);
    $updated = TRUE;
  }

  if ($updated) {
    $account->save();
  }
}

/**
 * Returns social auth profile data when available.
 */
function _coffee_journal_api_get_social_auth_profile(): ?array {
  try {
    $session = \Drupal::service('social_auth.data_handler');
  }
  catch (\Throwable $e) {
    return NULL;
  }

  if (!method_exists($session, 'get')) {
    return NULL;
  }

  try {
    $profile = $session->get('social_auth_google') ?? $session->get('social_auth_google_user_profile') ?? $session->get('social_auth_google_profile');
  }
  catch (\Throwable $e) {
    // Some social_api implementations may not be fully initialised in certain
    // environments (eg. CLI or during tests). Fail gracefully.
    return NULL;
  }

  if (is_array($profile)) {
    return $profile;
  }

  return NULL;
}

/**
 * Saves a remote profile image into public:// and returns the managed File.
 */
function _coffee_journal_api_save_remote_profile_image(string $image_url): ?File {
  // Use Guzzle HTTP client with timeout instead of file_get_contents.
  try {
    $client = \Drupal::httpClient();
    $response = $client->get($image_url, ['timeout' => 5]);
    $data = $response->getBody()->getContents();
  }
  catch (\Throwable $e) {
    return NULL;
  }

  if (empty($data)) {
    return NULL;
  }

  $file_system = \Drupal::service('file_system');
  $directory = 'public://social_auth_google_profiles';

  // Use modern Drupal 11 file_system service instead of file_prepare_directory().
  if (!$file_system->prepareDirectory(
    $directory,
    \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY |
    \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS
  )) {
    return NULL;
  }

  $filename = basename(parse_url($image_url, PHP_URL_PATH) ?? 'profile.jpg');
  $filename = preg_replace('/[^a-zA-Z0-9._-]+/', '_', $filename) ?: 'profile.jpg';
  $destination = $directory . '/' . $filename;

  // Use modern file.repository service instead of file_save_data().
  try {
    $file = \Drupal::service('file.repository')->writeData(
      $data,
      $destination,
      \Drupal\Core\File\FileSystemInterface::EXISTS_RENAME
    );
    if ($file instanceof File) {
      $file->setPermanent();
      $file->save();
      return $file;
    }
  }
  catch (\Throwable $e) {
    return NULL;
  }

  return NULL;
}


/**
 * Implements hook_form_FORM_ID_alter() for brew_recipe add form.
 *
 * Prefill the field_coffee_bean_ref entity reference when a query param
 * `field_coffee_bean_ref_target_id` is present, and hide the field since
 * the bean is already determined.
 */
function coffee_journal_api_form_node_brew_recipe_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $request = \Drupal::request();
  $prefill = $request->query->get('field_coffee_bean_ref_target_id');
  if ($prefill && is_numeric($prefill)) {
    $bean = \Drupal\node\Entity\Node::load((int) $prefill);
    if ($bean && isset($form['field_coffee_bean_ref']['widget'][0]['target_id'])) {
      $form['field_coffee_bean_ref']['widget'][0]['target_id']['#default_value'] = $bean;
      // Hide the field — the association is already determined.
      $form['field_coffee_bean_ref']['#access'] = FALSE;
    }
  }
}


/**
 * Implements hook_preprocess_node() to add recipe_count to coffee_bean nodes
 * and to inject rendered related recipe teasers into the coffee_bean add/edit
 * form via form_alter (the theme will render form.cj_related_recipes).
 */
function coffee_journal_api_preprocess_node(array &$variables) {
  $node = $variables['node'] ?? NULL;
  if (!$node || $node->getType() !== 'coffee_bean') {
    return;
  }

  try {
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'brew_recipe')
      ->condition('status', 1)
      ->condition('field_coffee_bean_ref', $node->id());
    $nids = $query->execute();
    $count = is_array($nids) ? count($nids) : 0;
  }
  catch (\Throwable $e) {
    $count = 0;
  }

  $variables['recipe_count'] = $count;
}


/**
 * Implements hook_form_node_coffee_bean_edit_form_alter().
 *
 * Adds a Recipes section (list of related brew_recipe nodes + Add Recipe
 * button) to the coffee_bean edit form. Only runs on the edit form because
 * a new coffee_bean has no NID yet and cannot be referenced by a recipe.
 */
function coffee_journal_api_form_node_coffee_bean_edit_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  _coffee_journal_api_add_recipe_section($form, $form_state);
  $bean = $form_state->getFormObject()->getEntity();
  $orders = \Drupal::service('coffee_journal_api.orders');
  if ($orders->enabled()) {
    $form['cj_orders'] = [
      '#type' => 'details', '#title' => t('Order history'), '#open' => TRUE, '#weight' => 29,
      'add' => ['#type' => 'link', '#title' => t('Add order'), '#url' => \Drupal\Core\Url::fromRoute('node.add', ['node_type' => 'coffee_order'], ['query' => ['coffee' => $bean->uuid()]])],
      'history' => ['#type' => 'table', '#header' => [t('Date'), t('Quantity'), t('Status')], '#rows' => []],
    ];
    foreach ($orders->history($bean) as $order) {
      $form['cj_orders']['history']['#rows'][] = [
        $order->get('field_purchase_date')->value,
        $order->get('field_quantity')->value . ' ' . $order->get('field_quantity_unit')->value,
        $order->get('field_is_finished')->value ? t('Completed') : t('Current bag'),
      ];
    }
  }
}

/** Implements hook_form_node_coffee_bean_form_alter(). */
function coffee_journal_api_form_node_coffee_bean_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!\Drupal::service('coffee_journal_api.orders')->enabled()) {
    return;
  }
  $form['cj_existing_coffee'] = [
    '#type' => 'entity_autocomplete', '#title' => t('Search your existing coffees'),
    '#target_type' => 'node', '#selection_settings' => ['target_bundles' => ['coffee_bean']],
    '#description' => t('Select a coffee and choose Add order to keep its rating and purchase history together.'),
    '#weight' => -20,
  ];
  $form['cj_add_order'] = [
    '#type' => 'submit', '#value' => t('Add order for selected coffee'), '#weight' => -19,
    '#limit_validation_errors' => [['cj_existing_coffee']],
    '#submit' => ['coffee_journal_api_existing_coffee_order_submit'],
  ];
  $form['#validate'][] = 'coffee_journal_api_validate_duplicate_coffee';
}

/** Prevent accidental exact-identity duplicate cards in the legacy add form. */
function coffee_journal_api_validate_duplicate_coffee(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $bean = $form_state->getFormObject()->getEntity();
  if (\Drupal::service('coffee_journal_api.orders')->duplicate($bean)) {
    $form_state->setErrorByName('title', t('This coffee already exists. Select it above and add an order instead.'));
  }
}

/** Route the existing-coffee shortcut to the order form. */
function coffee_journal_api_existing_coffee_order_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $id = $form_state->getValue('cj_existing_coffee');
  $bean = $id ? \Drupal\node\Entity\Node::load($id) : NULL;
  if (!$bean || $bean->bundle() !== 'coffee_bean' || (int) $bean->getOwnerId() !== (int) \Drupal::currentUser()->id()) {
    \Drupal::messenger()->addError(t('Choose one of your coffees first.'));
    return;
  }
  $form_state->setRedirect('node.add', ['node_type' => 'coffee_order'], ['query' => ['coffee' => $bean->uuid()]]);
}

/** Implements hook_form_alter(). */
function coffee_journal_api_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if (!in_array($form_id, ['node_coffee_order_form', 'node_coffee_order_edit_form'], TRUE)) {
    return;
  }
  $order = $form_state->getFormObject()->getEntity();
  if ($order->isNew()) {
    $order->setTitle('Coffee order');
    $uuid = \Drupal::request()->query->get('coffee');
    $bean = is_string($uuid) ? \Drupal::service('coffee_journal_api.presenter')->loadNode($uuid, 'coffee_bean') : NULL;
    if ($bean && (int) $bean->getOwnerId() === (int) \Drupal::currentUser()->id()) {
      $order->set('field_coffee_bean_ref', $bean->id());
      $form['field_coffee_bean_ref']['widget'][0]['target_id']['#default_value'] = $bean;
    }
  }
  $form['title']['#access'] = FALSE;
  $form['#validate'][] = 'coffee_journal_api_validate_order_owner';
}

/** Entity-reference access alone does not guarantee ownership for admins. */
function coffee_journal_api_validate_order_owner(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $order = $form_state->getFormObject()->getEntity();
  $bean = $order->get('field_coffee_bean_ref')->entity;
  if (!$bean || $bean->bundle() !== 'coffee_bean' || (int) $bean->getOwnerId() !== (int) $order->getOwnerId()) {
    $form_state->setErrorByName('field_coffee_bean_ref', t('Choose a coffee belonging to the order owner.'));
  }
}

/**
 * Adds the Recipes section to the coffee_bean edit form.
 *
 * Uses proper render arrays (no renderRoot) so it is safe to call from a
 * form alter hook. The "Add Recipe" button carries a data-bean-nid attribute
 * so the JS behaviour can build the correct add-recipe URL without needing
 * drupalSettings from the fetched page.
 */
function _coffee_journal_api_add_recipe_section(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->isNew()) {
    return;
  }

  $nid = (int) $node->id();

  // Build render array of existing recipe teasers — no renderRoot() here.
  $items_element = [
    '#type' => 'container',
    '#attributes' => ['id' => 'cj-bean-recipes'],
  ];

  try {
    $nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'brew_recipe')
      ->condition('status', 1)
      ->condition('field_coffee_bean_ref', $nid)
      ->sort('created', 'DESC')
      ->range(0, 6)
      ->execute();

    if (!empty($nids)) {
      $recipe_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $view_builder  = \Drupal::entityTypeManager()->getViewBuilder('node');
      foreach (array_values($recipe_nodes) as $idx => $recipe_node) {
        $items_element['recipe_' . $idx] = $view_builder->view($recipe_node, 'teaser');
      }
    }
    else {
      $items_element['empty'] = [
        '#markup' => \Drupal\Core\Render\Markup::create(
          '<p class="cj-recipes-empty">' . t('No recipes yet.') . '</p>'
        ),
      ];
    }
  }
  catch (\Throwable $e) {
    $items_element['empty'] = [
      '#markup' => \Drupal\Core\Render\Markup::create(
        '<p class="cj-recipes-empty">' . t('No recipes yet.') . '</p>'
      ),
    ];
  }

  $add_label = (string) t('+ Add Recipe');

  $form['cj_recipes'] = [
    '#type'       => 'container',
    '#attributes' => ['class' => ['cj-form-recipes'], 'id' => 'cj-bean-recipes-wrap'],
    '#weight'     => 30,
    'label'       => [
      '#markup' => \Drupal\Core\Render\Markup::create(
        '<div class="cj-section__label">' . t('Recipes') . '</div>'
      ),
    ],
    'items'       => $items_element,
    'actions'     => [
      '#type'       => 'container',
      '#attributes' => ['class' => ['cj-form-recipes__actions']],
      'btn'         => [
        '#markup' => \Drupal\Core\Render\Markup::create(
          '<button type="button" class="button button--primary" data-cj-add-recipe data-bean-nid="' . $nid . '">'
          . $add_label . '</button>'
        ),
      ],
    ],
  ];
}
