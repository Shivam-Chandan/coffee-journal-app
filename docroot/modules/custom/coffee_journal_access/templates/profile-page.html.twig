{#
  Profile page — wireframe layout.
  Variables: user, stats, tab, tiles.
#}
<div class="cj-profile-screen">

  {# ── Header: avatar + name + stats ────────────────────────────────────── #}
  <div class="cj-profile-header">

    <div class="cj-profile-identity">
      {# Avatar: photo or initial #}
      {% if user.picture_url %}
        <img class="cj-avatar cj-avatar--lg"
             src="{{ user.picture_url }}"
             alt="{{ user.name }}"
             width="52" height="52">
      {% else %}
        <div class="cj-avatar cj-avatar--lg" aria-hidden="true">
          {{ user.initial|default('?') }}
        </div>
      {% endif %}

      <div class="cj-profile-meta">
        <span class="cj-profile-name">{{ user.name }}</span>
        <span class="cj-profile-handle">{{ 'joined'|t }} {{ user.created|date('M Y') }}</span>

        <div class="cj-profile-stats">
          <span>
            <strong>{{ stats.beans }}</strong>
            {{ 'beans'|t }}
          </span>
          <span>
            <strong>{{ stats.brews }}</strong>
            {{ 'brews'|t }}
          </span>
          <span>
            <strong>{{ stats.hearts }}</strong>
            ♡
          </span>
        </div>
      </div>
    </div>

    {# Theme toggle — moved here from topbar #}
    <button id="cj-theme-toggle"
            class="cj-profile-theme-btn"
            aria-label="{{ 'Toggle colour theme'|t }}"
            title="{{ 'Toggle colour theme'|t }}">
      <span aria-hidden="true">🌙</span>
    </button>

  </div>

  {# ── Filter chips ──────────────────────────────────────────────────────── #}
  <div class="cj-filter-strip" role="tablist" aria-label="{{ 'Profile sections'|t }}">
    <a href="{{ path('coffee_journal_access.profile') }}"
       class="cj-chip{% if tab == 'posts' %} cj-chip--filled{% endif %}"
       role="tab"
       aria-selected="{{ tab == 'posts' ? 'true' : 'false' }}">
      {{ 'Public posts'|t }}
    </a>
    <a href="{{ path('coffee_journal_access.profile') }}?tab=beans"
       class="cj-chip{% if tab == 'beans' %} cj-chip--filled{% endif %}"
       role="tab"
       aria-selected="{{ tab == 'beans' ? 'true' : 'false' }}">
      {{ 'Beans'|t }}
    </a>
    <a href="{{ path('coffee_journal_access.profile') }}?tab=brews"
       class="cj-chip{% if tab == 'brews' %} cj-chip--filled{% endif %}"
       role="tab"
       aria-selected="{{ tab == 'brews' ? 'true' : 'false' }}">
      {{ 'Brews'|t }}
    </a>
    <a href="{{ path('coffee_journal_access.profile') }}?tab=saved"
       class="cj-chip{% if tab == 'saved' %} cj-chip--filled{% endif %}"
       role="tab"
       aria-selected="{{ tab == 'saved' ? 'true' : 'false' }}">
      {{ 'Saved'|t }}
    </a>
  </div>

  {# ── Content grid ──────────────────────────────────────────────────────── #}
  {% if tiles is empty %}
    <div class="cj-wf-empty">
      <svg class="cj-wf-empty__glyph" viewBox="0 0 16 16" aria-hidden="true">
        <ellipse cx="8" cy="8" rx="5" ry="6.5"
                 stroke="currentColor" stroke-width="1.2" fill="none"
                 transform="rotate(30 8 8)"/>
        <path d="M5 4 Q 8 8, 11 12"
              stroke="currentColor" stroke-width="1.2" fill="none"
              transform="rotate(30 8 8)"/>
      </svg>
      {% if tab == 'saved' %}
        <p>{{ 'Nothing saved yet.'|t }}</p>
        <p class="cj-wf-empty__sub">{{ 'Tap ⌑ on a public brew to save it.'|t }}</p>
      {% elseif tab == 'beans' %}
        <p>{{ 'No beans yet.'|t }}</p>
        <p class="cj-wf-empty__sub">{{ 'Tap + to log your first bean.'|t }}</p>
      {% elseif tab == 'brews' %}
        <p>{{ 'No brews yet.'|t }}</p>
        <p class="cj-wf-empty__sub">{{ 'Open a bean and tap + to add a brew recipe.'|t }}</p>
      {% else %}
        <p>{{ 'Nothing shared yet.'|t }}</p>
        <p class="cj-wf-empty__sub">{{ 'Share a private brew recipe to see it here.'|t }}</p>
      {% endif %}
    </div>
  {% else %}
    <div class="cj-profile-grid">
      {% for tile in tiles %}
        <a href="{{ tile.url }}"
           class="cj-profile-tile"
           aria-label="{{ tile.title }}">
          {% if tile.image_url %}
            <img src="{{ tile.image_url }}" alt="{{ tile.title }}" loading="lazy">
          {% else %}
            <div class="cj-image-stripe" aria-hidden="true"></div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# ── Edit profile link ─────────────────────────────────────────────────── #}
  <div class="cj-profile-footer">
    <a href="{{ path('user.edit') }}" class="cj-profile-edit-btn">
      {{ 'Edit profile'|t }}
    </a>
  </div>

</div>
