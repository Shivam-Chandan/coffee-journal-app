<?php

declare(strict_types=1);

/**
 * @file
 * Coffee Journal Access — node access control + URL alias generation
 * + form alterations to match the source app's CoffeeForm.tsx UI.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;
use Drupal\path_alias\Entity\PathAlias;

/**
 * Implements hook_theme().
 */
function coffee_journal_access_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'profile_page' => [
      'variables' => [
        'user' => [],
      ],
      'template' => 'profile-page',
      'path' => $path . '/templates',
    ],
  ];
}

// ── Access control ─────────────────────────────────────────────────────────

/**
 * Implements hook_node_access().
 *
 * Let the brew_privacy node access records and grants manage coffee_bean
 * visibility rules so private entries remain hidden by default.
 */
function coffee_journal_access_node_access(NodeInterface $node, $op, AccountInterface $account) {
  if ($node->bundle() !== 'coffee_bean') {
    return AccessResult::neutral();
  }

  return AccessResult::neutral();
}

// ── Form alterations ────────────────────────────────────────────────────────

/**
 * Implements hook_form_node_coffee_bean_form_alter().
 *
 * Alters the coffee_bean node add form to match CoffeeForm.tsx:
 *   - Renames "Title" label to "Coffee Name"
 *   - Injects "Taste Profile" section heading before bitterness slider
 *   - Sets source-app-matching default values
 */
function coffee_journal_access_form_node_coffee_bean_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _coffee_journal_access_alter_coffee_form($form, TRUE);
}

/**
 * Implements hook_form_node_coffee_bean_edit_form_alter().
 */
function coffee_journal_access_form_node_coffee_bean_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _coffee_journal_access_alter_coffee_form($form, FALSE);
}

/**
 * Shared form alterations for add and edit forms.
 *
 * @param array  $form    The form array (by reference).
 * @param bool   $is_add  TRUE on the add form, FALSE on the edit form.
 */
function _coffee_journal_access_alter_coffee_form(array &$form, bool $is_add): void {
  // ── 1. Inline URL scraper widget (Fix 4) ───────────────────────────────
  // Injected as a form element instead of a template so it is guaranteed to
  // appear regardless of Drupal's template-discovery for node forms.
  // The cjFormScraper JS behaviour handles the fetch + field-fill logic.
  $form['cj_inline_scraper'] = [
    '#type'         => 'markup',
    '#weight'       => -10,
    '#allowed_tags' => ['div', 'input', 'button', 'span', 'svg', 'path', 'circle'],
    '#markup'       => '
<div class="cj-form-scraper-inline" id="cj-inline-scraper">
  <div class="cj-scraper-inline__header">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2.5"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
    </svg>
    <span>' . t('Auto-fill details from URL') . '</span>
  </div>
  <div class="cj-scraper-inline__row">
    <input type="url"
           id="cj-inline-scraper-url"
           class="cj-scraper-inline__input"
           placeholder="' . t('Paste product page URL…') . '"
           autocomplete="off"
           aria-label="' . t('Product page URL') . '">
    <button type="button"
            id="cj-inline-scraper-btn"
            class="cj-scraper-inline__btn">
      <span class="cj-inline-btn-label">' . t('Auto-fill') . '</span>
      <span class="cj-inline-spinner" aria-hidden="true" hidden></span>
    </button>
  </div>
  <div id="cj-inline-scraper-status"
       class="cj-scraper-inline__status"
       role="status"
       aria-live="polite"></div>
</div>',
  ];

  // ── 2. Rename "Title" → "Coffee Name" ─────────────────────────────────
  if (isset($form['title']['widget'][0]['value'])) {
    $form['title']['widget'][0]['value']['#title']       = t('Coffee Name');
    $form['title']['widget'][0]['value']['#placeholder'] = t('e.g. Vienna Roast');
  }
  if (isset($form['title']['#title'])) {
    $form['title']['#title'] = t('Coffee Name');
  }

  // ── 3. Brand Name placeholder ─────────────────────────────────────────
  if (isset($form['field_brand_roaster']['widget'][0]['value'])) {
    $form['field_brand_roaster']['widget'][0]['value']['#placeholder'] = t('e.g. Blue Tokai');
  }

  // ── 4. Inject "Taste Profile" heading ─────────────────────────────────
  $form['cj_taste_profile_heading'] = [
    '#type'         => 'markup',
    '#markup'       => '<span class="cj-taste-profile-label">' . t('Taste Profile') . '</span>',
    '#weight'       => 9,
    '#allowed_tags' => ['span'],
  ];

  // ── 5. Tasting notes — lock to plain_text, hide format toolbar (Fix 3) ─
  // field_flavour_notes is text_long which can show a CKEditor toolbar.
  // Setting allowed_formats to plain_text only prevents CKEditor from loading.
  if (isset($form['field_flavour_notes']['widget'][0])) {
    $form['field_flavour_notes']['widget'][0]['#allowed_formats'] = ['plain_text'];
    // Hide the text-format selector entirely — plain textarea only.
    if (isset($form['field_flavour_notes']['widget'][0]['format'])) {
      $form['field_flavour_notes']['widget'][0]['format']['#access'] = FALSE;
    }
  }

  // ── 6. Hide revision log ───────────────────────────────────────────────
  if (isset($form['revision_log'])) {
    $form['revision_log']['#access'] = FALSE;
  }

  // ── 7. Default values on add form (match source app defaults) ─────────
  if ($is_add) {
    if (isset($form['field_quantity']['widget'][0]['value'])) {
      $form['field_quantity']['widget'][0]['value']['#default_value'] = 250;
    }
    if (isset($form['field_bitterness_rating']['widget'][0]['value'])) {
      $form['field_bitterness_rating']['widget'][0]['value']['#default_value'] = 5;
    }
    if (isset($form['field_acidity_rating']['widget'][0]['value'])) {
      $form['field_acidity_rating']['widget'][0]['value']['#default_value'] = 5;
    }
    if (isset($form['field_note_clarity_rating']['widget'][0]['value'])) {
      $form['field_note_clarity_rating']['widget'][0]['value']['#default_value'] = 5;
    }
  }
}

// ── URL alias generation ────────────────────────────────────────────────────

/**
 * Implements hook_node_insert().
 */
function coffee_journal_access_node_insert(NodeInterface $node): void {
  if ($node->bundle() === 'coffee_bean') {
    _coffee_journal_access_save_alias($node);
  }
}

/**
 * Implements hook_node_update().
 */
function coffee_journal_access_node_update(NodeInterface $node): void {
  if ($node->bundle() !== 'coffee_bean') {
    return;
  }

  $original = $node->original ?? NULL;
  if ($original && $original->getTitle() === $node->getTitle()) {
    return;
  }

  _coffee_journal_access_save_alias($node);
}

/**
 * Create or update the /my-coffees/<slug> alias for a coffee_bean node.
 */
function _coffee_journal_access_save_alias(NodeInterface $node): void {
  $system_path = '/node/' . $node->id();
  $alias       = '/my-coffees/' . _coffee_journal_access_slugify($node->getTitle());

  $existing = \Drupal::entityTypeManager()
    ->getStorage('path_alias')
    ->loadByProperties(['path' => $system_path]);

  foreach ($existing as $old_alias) {
    $old_alias->delete();
  }

  PathAlias::create([
    'path'     => $system_path,
    'alias'    => $alias,
    'langcode' => $node->language()->getId(),
  ])->save();
}

/**
 * Convert a string to a URL-safe slug.
 */
function _coffee_journal_access_slugify(string $text): string {
  $slug = strtolower($text);
  $slug = preg_replace('/[^a-z0-9]+/', '-', $slug) ?? '';
  return trim($slug, '-');
}
